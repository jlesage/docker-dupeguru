# Do not follow directory symlinks while scanning, and do not delete a
# duplicate whose path is only another name for the reference file.
#
# dupeGuru 4.3.1 descends into a symlink to a directory (DirEntry.is_dir()
# follows links). The target's files are then listed a second time. Replacing
# that "duplicate" with a symlink unlinks the only directory entry, so the
# original file is replaced by a symlink to itself.
#
# Hard links are left alone: they are a second name, and removing one leaves
# the reference. See https://github.com/arsenetar/dupeguru/issues/1111
# and https://github.com/arsenetar/dupeguru/issues/1270.
#
--- a/core/fs.py
+++ b/core/fs.py
@@ -391,6 +391,16 @@
         return not path.is_symlink() and path.is_dir()
 
 
+def same_directory_entry(path_a, path_b):
+    """Return True when both paths name the same directory entry.
+
+    Hard links are separate names for one inode, so unlinking one leaves the
+    other. A directory symlink does not create a second name: ``real/file`` and
+    ``link/file`` are the same entry, and unlinking either removes the only one.
+    """
+    return os.path.realpath(path_a) == os.path.realpath(path_b)
+
+
