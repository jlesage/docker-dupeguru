+    def _iter_unique_roots(self):
+        # Two selected folders can be the same directory when one path reaches
+        # it through a symlink. Scanning both would offer that directory's files
+        # as duplicates of themselves.
+        seen = set()
+        for path in self._dirs:
+            try:
+                key = os.path.realpath(path)
+            except OSError:
+                key = os.path.normpath(str(path))
+            if key in seen:
+                logging.info("Skipping '%s' because it is already selected as '%s'", path, key)
+                continue
+            seen.add(key)
+            yield path
+
