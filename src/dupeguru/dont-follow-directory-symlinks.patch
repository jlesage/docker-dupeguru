+def _is_link(entry):
+    """Return True for a symbolic link or a Windows directory junction."""
+    try:
+        if entry.is_symlink():
+            return True
+    except OSError:
+        return True
+    is_junction = getattr(entry, "is_junction", None)
+    if is_junction is None:
+        return False
+    try:
+        return bool(is_junction())
+    except OSError:
+        return True
+
